{
  "name": "library-desk",
  "private": true,
  "version": "1.0.0",
  "description": "LIBRARY / DESK — Full-Stack Library Management System workstation with React, Spring Boot 3 & PostgreSQL.",
  "homepage": "https://Kurinji-Eswar.github.io/library-desk",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "backend:build": "mvn -f backend/pom.xml clean package -DskipTests=true",
    "backend:test": "mvn -f backend/pom.xml test",
    "backend:start": "java -jar backend/target/library-desk-backend-1.0.0.jar",
    "lint": "eslint src --ext .js,.jsx"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  }
}
