# =============================================================================
# LIBRARY / DESK — Environment Configuration Template
# =============================================================================

# Frontend API URL configuration
# Points to Spring Boot REST backend
VITE_API_BASE_URL=http://localhost:8080/api

# Backend Database Credentials (Set as system environment variables or command line overrides)
DB_URL=jdbc:postgresql://localhost:5432/library_desk
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Backend Server Port
SERVER_PORT=8080

# CORS Allowed Origins (comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://kurinji-eswar.github.io
